# Local dashboard
DEV_AUTH_DISABLED=true
ALLOWED_TENANT_IDS=72f988bf-86f1-41af-91ab-2d7cd011db47,6fdb5200-3d0d-4a8a-b036-d3685e359adc,2bb51c06-af9b-42c5-8bf5-3c3b7b10850b
ENTRA_CLIENT_ID=

# Serve the dashboard anonymously (v1). Must be exactly "true" to take effect.
# Unset this before any security findings are surfaced in the UI.
# See docs/security/threat-model.md.
PUBLIC_DASHBOARD=true

# Public GitHub metadata collection
GITHUB_ORGANIZATION=bcgov
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional bearer-token override for local verification or a future GitHub App installation token.
GITHUB_TOKEN=

# Azure runtime identity and evidence
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_NAME=
KEY_VAULT_URI=

# Local evidence storage via Azurite (docker-compose.yml).
# Both must be set, and are ignored when NODE_ENV=production.
# AZURE_STORAGE_KEY is Azurite's well-known development key, printed by the
# container at startup and published in the Azurite documentation.
AZURE_STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000
AZURE_STORAGE_KEY=

# PostgreSQL Flexible Server
PGHOST=
PGPORT=5432
PGDATABASE=gitinsights
PGUSER=id-gitinsights-runtime
PGPOOL_MAX=5

# Local PostgreSQL via docker-compose.yml. Setting PGPASSWORD switches the pool
# to password auth with TLS off; ignored when NODE_ENV=production.
# PGHOST=127.0.0.1
# PGPORT=5433
# PGUSER=gitinsights
# PGPASSWORD=localdev

# Microsoft Foundry
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL=

# OpenTelemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
