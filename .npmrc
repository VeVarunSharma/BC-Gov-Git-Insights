engine-strict=false
inject-workspace-packages=true
prefer-workspace-packages=true
shared-workspace-lockfile=true

# Next.js treats require-in-the-middle and import-in-the-middle as runtime
# externals and require()s them from the app root. pnpm's strict layout leaves
# them nested under @opentelemetry/instrumentation, so the Azure Monitor
# instrumentation hook fails to load and the server exits before it listens.
# Hoisting keeps the resolved versions intact instead of pinning our own.
public-hoist-pattern[]=*-in-the-middle
